# 应用运行时密钥。复制为 app.env 后填写本地值，不要提交 app.env。
GINCHAT_MYSQL_PASSWORD=change-me
GINCHAT_JWT_SECRET=change-me
GINCHAT_REDIS_PASSWORD=change-me

# 可选覆盖项
# GINCHAT_CONFIG_FILE=E:\path\to\app.yml
# GINCHAT_SERVER_ADDR=127.0.0.1:8081
# GINCHAT_MYSQL_DBNAME=ginchat_v2
# GINCHAT_MYSQL_LOCATION=UTC
# GINCHAT_SNOWFLAKE_WORK_ID=1
