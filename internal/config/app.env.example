# 应用运行时密钥。复制为 app.env 后填写本地值，不要提交 app.env。
RELAYIM_MYSQL_PASSWORD=change-me
# 单实例连接上限；多实例部署时需保证总和低于 MySQL max_connections
RELAYIM_MYSQL_MAX_OPEN=50
RELAYIM_MYSQL_MAX_IDLE=10
RELAYIM_MYSQL_CONN_MAX_LIFETIME_MINUTES=30
RELAYIM_JWT_SECRET=change-me
RELAYIM_JWT_REFRESH_EXPIRE_DAYS=30
RELAYIM_REDIS_PASSWORD=change-me
RELAYIM_REDIS_DIAL_TIMEOUT_SECONDS=3
RELAYIM_REDIS_READ_TIMEOUT_SECONDS=2
RELAYIM_REDIS_WRITE_TIMEOUT_SECONDS=2
RELAYIM_REDIS_POOL_TIMEOUT_SECONDS=3
RELAYIM_REDIS_MAX_RETRIES=1
RELAYIM_RABBITMQ_URL=amqp://user:password@127.0.0.1:5672/relayim
RELAYIM_S3_ACCESS_KEY=change-me
RELAYIM_S3_SECRET_KEY=change-me
RELAYIM_S3_PUBLIC_ENDPOINT=
RELAYIM_WS_TICKET_RATE_LIMIT_GLOBAL=250
RELAYIM_WS_TICKET_RATE_LIMIT_USER=10
RELAYIM_WS_TICKET_RATE_LIMIT_WINDOW_MS=1000
RELAYIM_TRACING_ENABLED=true
RELAYIM_TRACING_OTLP_ENDPOINT=http://127.0.0.1:4318
RELAYIM_TRACING_SAMPLE_RATIO=1.0
RELAYIM_ATTACHMENT_CLEANUP_ENABLED=true
RELAYIM_ATTACHMENT_CLEANUP_INTERVAL_SECONDS=3600
RELAYIM_ATTACHMENT_CLEANUP_PENDING_TTL_HOURS=24
RELAYIM_ATTACHMENT_CLEANUP_CLAIM_LEASE_SECONDS=600
RELAYIM_ATTACHMENT_CLEANUP_BATCH_SIZE=100

# 可选覆盖项
# RELAYIM_CONFIG_FILE=E:\path\to\app.yml
# RELAYIM_SERVER_ADDR=127.0.0.1:8081
# RELAYIM_MYSQL_DBNAME=relayim
# RELAYIM_MYSQL_LOCATION=UTC
# RELAYIM_SNOWFLAKE_WORK_ID=1
