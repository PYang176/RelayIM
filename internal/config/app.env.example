# 应用运行时密钥。复制为 app.env 后填写本地值，不要提交 app.env。
GINCHAT_MYSQL_PASSWORD=change-me
GINCHAT_JWT_SECRET=change-me
GINCHAT_JWT_REFRESH_EXPIRE_DAYS=30
GINCHAT_REDIS_PASSWORD=change-me
GINCHAT_RABBITMQ_URL=amqp://user:password@127.0.0.1:5672/ginchat
GINCHAT_S3_ACCESS_KEY=change-me
GINCHAT_S3_SECRET_KEY=change-me
GINCHAT_WS_TICKET_RATE_LIMIT_GLOBAL=250
GINCHAT_WS_TICKET_RATE_LIMIT_USER=10
GINCHAT_WS_TICKET_RATE_LIMIT_WINDOW_MS=1000
GINCHAT_TRACING_ENABLED=true
GINCHAT_TRACING_OTLP_ENDPOINT=http://127.0.0.1:4318
GINCHAT_TRACING_SAMPLE_RATIO=1.0
GINCHAT_ATTACHMENT_CLEANUP_ENABLED=true
GINCHAT_ATTACHMENT_CLEANUP_INTERVAL_SECONDS=3600
GINCHAT_ATTACHMENT_CLEANUP_PENDING_TTL_HOURS=24
GINCHAT_ATTACHMENT_CLEANUP_CLAIM_LEASE_SECONDS=600
GINCHAT_ATTACHMENT_CLEANUP_BATCH_SIZE=100

# 可选覆盖项
# GINCHAT_CONFIG_FILE=E:\path\to\app.yml
# GINCHAT_SERVER_ADDR=127.0.0.1:8081
# GINCHAT_MYSQL_DBNAME=ginchat_v2
# GINCHAT_MYSQL_LOCATION=UTC
# GINCHAT_SNOWFLAKE_WORK_ID=1
