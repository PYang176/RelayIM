# Copy this file to .env and change every password before starting.
RABBITMQ_DEFAULT_USER=relayim
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_VHOST=relayim

REDIS_PASSWORD=change-me
# Redis 容器在宿主机上的端口；避免与其他本地 Redis 默认端口冲突
REDIS_HOST_PORT=6380

MINIO_ROOT_USER=relayim
MINIO_ROOT_PASSWORD=change-me-minio

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

PROMETHEUS_RETENTION=15d
