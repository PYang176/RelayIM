# RelayIM 应用容器变量。复制为 app.env 后填写实际值，不要提交 app.env。
RELAYIM_MYSQL_ROOT_PASSWORD=change-me-mysql
RELAYIM_JWT_SECRET=change-me-to-a-long-random-secret

# 浏览器直接访问宿主机映射的 SeaweedFS 端口。
RELAYIM_S3_PUBLIC_ENDPOINT=http://localhost:8333

RELAYIM_TRACING_ENABLED=true
RELAYIM_ATTACHMENT_CLEANUP_ENABLED=true
RELAYIM_RABBITMQ_CONSUMER_WORKERS=4
RELAYIM_WS_TICKET_RATE_LIMIT_GLOBAL=500
RELAYIM_MESSAGE_RATE_LIMIT_USER=20
RELAYIM_MESSAGE_RATE_LIMIT_GLOBAL=1000
RELAYIM_MESSAGE_RATE_LIMIT_WINDOW_MS=10000
